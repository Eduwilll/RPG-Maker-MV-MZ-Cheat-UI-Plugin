{
  "name": "rpg-cheat-ui-plugin-docs",
  "version": "1.9.1",
  "description": "Documentation for RPG Maker MV/MZ Cheat UI Plugin",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node tools/test-unit.mjs",
    "test:browser": "node tools/test-browser.mjs",
    "test:preview": "node tools/test-browser.mjs --preview",
    "check:mv-compat": "node tools/check-mv-compat.mjs",
    "check:repo": "pnpm run test:unit && pnpm run typecheck && pnpm run check:mv-compat && pnpm run docs:build",
    "format": "prettier . --write",
    "prepare": "husky install"
  },
  "keywords": [
    "rpg-maker",
    "mz",
    "mv",
    "translation-tool",
    "cheat-engine-program"
  ],
  "author": "Eduwilll",
  "license": "MIT",
  "devDependencies": {
    "@fenixengine/rmmz-ts": "^1.2.0",
    "@types/node": "^25.9.4",
    "husky": "^8.0.3",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.1",
    "typescript": "^6.0.3",
    "vite": "8.1.6",
    "vitepress": "2.0.0-alpha.18",
    "vitepress-plugin-group-icons": "^1.7.5"
  },
  "lint-staged": {
    "**/*.{js,json,css}": "prettier --write"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
